    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const SECRET_KEYS = new Set([\"openaiKey\", \"password\", \"refreshToken\", \"refresh_token\", \"idToken\", \"id_token\", \"accessToken\", \"access_token\", \"apiKey\", \"api_key\", \"secret\", \"token\"]);\n\nfunction strip(value) {\n  if (Array.isArray(value)) return value.map(strip);\n  if (!value || typeof value !== \"object\") return value;\n  const out = {};\n  for (const [key, child] of Object.entries(value)) {\n    if (SECRET_KEYS.has(key)) continue;\n    out[key] = strip(child);\n  }\n  return out;\n}\n\nfunction readNode(name) {\n  const item = $(name).first();\n  const raw = item.json && Object.prototype.hasOwnProperty.call(item.json, \"data\") ? item.json.data : item.json;\n  if (raw == null || raw === \"\" || raw === \"null\") return null;\n  if (typeof raw === \"string\") return JSON.parse(raw);\n  return raw;\n}\n\nconst records = {\n  \"admin/uid\": readNode(\"읽기 admin uid\"),\n  accounts: readNode(\"읽기 accounts\"),\n  churchIndex: readNode(\"읽기 churchIndex\"),\n  deposits: readNode(\"읽기 deposits\"),\n  churches: readNode(\"읽기 churches\"),\n};\nconst cleaned = strip(records);\nif (cleaned.churches && typeof cleaned.churches === \"object\") {\n  for (const church of Object.values(cleaned.churches)) {\n    if (church && church.live && typeof church.live === \"object\") delete church.live.subtitles;\n  }\n}\nconst calendarDate = $now.setZone(\"Asia/Seoul\").toFormat(\"yyyy-MM-dd\");\nconst replica = {\n  exportedAt: $now.toISO(),\n  calendarDate,\n  timezone: \"Asia/Seoul\",\n  source: {\n    databaseURL: \"https://live-interpret-db65e-default-rtdb.asia-southeast1.firebasedatabase.app\",\n    rootPath: \"live-interpret\",\n  },\n  omitted: [\"platform/openaiKey\", \"phoneLinks\", \"churches/*/live/subtitles\"],\n  records: cleaned,\n};\nconst text = JSON.stringify(replica, null, 2) + \"\\n\";\nreturn [{\n  json: { calendarDate },\n  binary: {\n    data: {\n      data: Buffer.from(text, \"utf8\").toString(\"base64\"),\n      mimeType: \"application/json\",\n      fileName: calendarDate + \".json\",\n      fileExtension: \"json\",\n    },\n  },\n}];"
      },
