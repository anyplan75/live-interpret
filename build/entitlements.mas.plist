<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 프로비저닝 프로파일에 있는 앱 식별자와 같아야 TestFlight 설치가 된다. -->
  <key>com.apple.application-identifier</key>
  <string>ZJYZ656BL8.com.anyplan.live-interpret</string>
  <key>com.apple.developer.team-identifier</key>
  <string>ZJYZ656BL8</string>
  <!-- 부모와 자식이 포트를 주고받는 통로. 값은 팀 식별자.번들 ID 이고, Exact 프로파일의 ZJYZ656BL8.* 에 들어간다.
       group. 접두사와 라이브러리 검증을 끄는 권한은 넣지 않는다. 통로가 없으면 시작하자마자 중단점으로 꺼진다.
       자바스크립트 엔진용 JIT 권한은 프로세스마다 따로 둔다. 프로파일은 이 둘을 막지 않는다. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>ZJYZ656BL8.com.anyplan.live-interpret</string>
  </array>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
